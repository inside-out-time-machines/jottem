{
 "title": "Jottem-overzicht",
 "uid": "jottem-overzicht",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Componenten up",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(up == 1)",
     "refId": "A",
     "instant": true
    }
   ],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Componenten down",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(up == 0) OR on() vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Schijfgebruik /",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
   "title": "Geheugengebruik",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
     "refId": "A",
     "instant": true
    }
   ],
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "CPU (host)",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
     "refId": "A",
     "legendFormat": "cpu %"
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Traefik-verzoeken per service",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(traefik_service_requests_total[5m])) by (service)",
     "refId": "A",
     "legendFormat": "{{service}}"
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Geheugen per container",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(container_memory_working_set_bytes{name=~\"jottem-.*\"}) by (name)",
     "refId": "A",
     "legendFormat": "{{name}}"
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "MinIO-opslag per bucket",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "minio_bucket_usage_total_bytes",
     "refId": "A",
     "legendFormat": "{{bucket}}"
    }
   ],
   "id": 8
  }
 ]
}