# Kopieer naar .env (server) of .env.local (lokale smoke-test) en vul in.
# Secrets horen nooit in git.

# Let's Encrypt / Traefik (HTTP-01; de dns-challenge via TransIP is vervallen)
ACME_EMAIL=info@iotm.nl

# database
POSTGRES_WACHTWOORD=wijzig-mij
AUTHENTIK_DB_WACHTWOORD=wijzig-mij

# Authentik
AUTHENTIK_SECRET_KEY=wijzig-mij-lang-en-willekeurig
AUTHENTIK_BOOTSTRAP_WACHTWOORD=wijzig-mij

# object storage (MinIO, tijdelijk; later externe S3 met dezelfde variabelen)
S3_ACCESS_KEY=jottem
S3_SECRET_KEY=wijzig-mij-minimaal-8-tekens

# basisdomein van deze omgeving; alle hostnamen (api., auth., data., ...) leiden hiervan af
BASISDOMEIN=dev.iotm.nl

# mail-UI (Mailpit) achter basic-auth, formaat gebruiker:wachtwoord. Verplicht: zonder
# waarde weigert de stack te starten, want de mailbox is publiek bereikbaar en vangt ook
# de wachtwoordherstelmails van Authentik op.
MAILPIT_UI_AUTH=jottem:wijzig-mij
# wordt bij een lege database platformbeheerder; leeg laten = geen bootstrap
BOOTSTRAP_BEHEERDER=

# annotatieserver (AnnoRepo): root-api-key waarmee de backend schrijft; lezen is publiek
ANNO_API_KEY=wijzig-mij-lang-en-willekeurig

# Fuseki (RDF/SPARQL): beheer-UI-wachtwoord; publiek is alleen het /sparql-leespad
FUSEKI_ADMIN_WACHTWOORD=wijzig-mij

# social login (MVP: Google, Microsoft, Facebook) - client-registraties bij de providers,
# redirect-URI: https://auth.dev.iotm.nl/source/oauth/callback/<slug>/ (google|microsoft|facebook).
# Na invullen: ak apply_blueprint /blueprints/custom/jottem-social-login.yaml
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_MICROSOFT_CLIENT_ID=
SOCIAL_MICROSOFT_CLIENT_SECRET=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=

# monitoring (Grafana achter Authentik-OIDC): allebei verplicht, de stack start niet
# zonder. Het OIDC-secret moet gelijk zijn aan dat in de Grafana-blueprint van Authentik.
GRAFANA_ADMIN_WACHTWOORD=wijzig-mij
GRAFANA_OIDC_SECRET=wijzig-mij-lang-en-willekeurig

# dev-bypass voor authenticatie (X-Dev-Sub-headers); ALLEEN voor lokale smoke-tests
DEV_AUTH=0
# welke dev-identiteit de bypass gebruikt (alleen zinvol met DEV_AUTH=1):
# dev-piet (platformbeheerder), dev-otto (organisatiebeheerder), dev-mona (moderator),
# dev-anna (uploader)
# DEV_SUB=dev-piet

# sterke factor (TOTP/passkey) afdwingen voor beheer-/moderatierollen (amr-claim);
# tijdelijk 0 zolang MFA-enrollment in Authentik nog niet is ingericht
AMR_VERPLICHT=1

# Publieke URL's. Ze worden standaard afgeleid van BASISDOMEIN; overschrijf ze alleen
# als een dienst ergens anders staat, of voor de lokale smoke-test (127.0.0.1-adressen).
# Standaardwaarde staat tussen haakjes.
# WEB_PUBLIEK=http://127.0.0.1:8100     (https://${BASISDOMEIN})
# API_PUBLIEK=http://127.0.0.1:8101     (https://api.${BASISDOMEIN})
# S3_PUBLIEK=http://127.0.0.1:8103      (https://s3.${BASISDOMEIN})
# ANNO_PUBLIEK=                         (https://anno.${BASISDOMEIN})
# DATA_PUBLIEK=                         (https://data.${BASISDOMEIN})
# IIIF_PUBLIEK=                         (https://iiif.${BASISDOMEIN})
# OIDC_ISSUER=                          (https://auth.${BASISDOMEIN}/application/o/jottem/)
