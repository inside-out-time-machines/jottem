# Kopieer naar .env (server) of .env.local (lokale smoke-test) en vul in.
# Secrets horen nooit in git.

# Let's Encrypt / Traefik
ACME_EMAIL=info@iotm.nl
TRANSIP_ACCOUNT_NAME=vul-in
TRANSIP_KEY_BESTAND=/pad/naar/transip.key

# database
POSTGRES_WACHTWOORD=wijzig-mij
AUTHENTIK_DB_WACHTWOORD=wijzig-mij

# Authentik
AUTHENTIK_SECRET_KEY=wijzig-mij-lang-en-willekeurig
AUTHENTIK_BOOTSTRAP_WACHTWOORD=wijzig-mij

# object storage (MinIO, tijdelijk; later externe S3 met dezelfde variabelen)
S3_ACCESS_KEY=jottem
S3_SECRET_KEY=wijzig-mij-minimaal-8-tekens

# mail-UI (Mailpit) achter basic-auth, formaat gebruiker:wachtwoord (leeg = open)
MAILPIT_UI_AUTH=

# annotatieserver (AnnoRepo): root-api-key waarmee de backend schrijft; lezen is publiek
ANNO_API_KEY=wijzig-mij-lang-en-willekeurig

# social login (MVP: Google, Microsoft, Facebook) - client-registraties bij de providers,
# redirect-URI: https://auth.dev.iotm.nl/source/oauth/callback/<slug>/ (google|microsoft|facebook).
# Na invullen: ak apply_blueprint /blueprints/custom/jottem-social-login.yaml
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_MICROSOFT_CLIENT_ID=
SOCIAL_MICROSOFT_CLIENT_SECRET=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=

# dev-bypass voor authenticatie (X-Dev-Sub-headers); ALLEEN voor lokale smoke-tests
DEV_AUTH=0

# sterke factor (TOTP/passkey) afdwingen voor beheer-/moderatierollen (amr-claim);
# tijdelijk 0 zolang MFA-enrollment in Authentik nog niet is ingericht
AMR_VERPLICHT=1

# publieke URL's; voor de lokale smoke-test overschrijven met 127.0.0.1-adressen:
# WEB_PUBLIEK=http://127.0.0.1:8100
# API_PUBLIEK=http://127.0.0.1:8101
# S3_PUBLIEK=http://127.0.0.1:8103
