{
  "@context": [
    {
      "@vocab": "https://schema.org/"
    },
    {
      "dataset": {
        "@id": "https://schema.org/dataset",
        "@container": "@set"
      },
      "name": {
        "@id": "https://schema.org/name",
        "@language": "nl"
      },
      "description": {
        "@id": "https://schema.org/description",
        "@language": "nl"
      },
      "genre": {
        "@id": "https://schema.org/genre",
        "@language": "nl"
      }
    }
  ],
  "@type": "DataCatalog",
  "@embed": "@once",
  "@omitDefault": true,
  "publisher": {
    "@embed": "@always"
  },
  "dataset": {
    "@embed": "@once"
  }
}
