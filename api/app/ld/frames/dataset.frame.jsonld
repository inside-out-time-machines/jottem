{
  "@context": [
    {
      "@vocab": "https://schema.org/"
    },
    {
      "distribution": {
        "@id": "https://schema.org/distribution",
        "@container": "@set"
      },
      "inLanguage": {
        "@id": "https://schema.org/inLanguage",
        "@container": "@set"
      },
      "name": {
        "@id": "https://schema.org/name",
        "@language": "nl"
      },
      "description": {
        "@id": "https://schema.org/description",
        "@language": "nl"
      },
      "genre": {
        "@id": "https://schema.org/genre",
        "@language": "nl"
      }
    }
  ],
  "@type": "Dataset",
  "@embed": "@once",
  "@omitDefault": true,
  "publisher": {
    "@type": "Organization",
    "@embed": "@always",
    "contactPoint": {
      "@embed": "@always"
    }
  },
  "creator": {
    "@type": "Organization",
    "@embed": "@always",
    "contactPoint": {
      "@embed": "@always"
    }
  },
  "spatialCoverage": {
    "@embed": "@always"
  },
  "distribution": {
    "@embed": "@always"
  },
  "includedInDataCatalog": {
    "@embed": "@never"
  }
}
