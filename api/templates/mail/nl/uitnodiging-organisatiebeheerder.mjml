<mjml>
  <mj-body background-color="#f4f4f2">
    <mj-include path="../partials/header.mjml" />
    <mj-section background-color="#ffffff" padding="16px 24px 8px">
      <mj-column>
        <mj-text font-size="15px" line-height="1.6">
          <p>Beste {{ ontvangerNaam }},</p>
          <p>{{ uitnodigerNaam }} nodigt je uit als <strong>organisatiebeheerder</strong> van
          {{ organisatie.naam }} op Jottem, het platform waarmee inwoners foto's, documenten en
          herinneringen delen. Als organisatiebeheerder beheer je projecten, moderatoren en de
          datasetbeschrijvingen van je organisatie.</p>
          <p>Lees eerst de <a href="{{ spelregelsUrl }}">spelregels</a>. Met de knop hieronder
          bevestig je de uitnodiging en stel je je wachtwoord en tweestapsverificatie in.</p>
        </mj-text>
        <mj-button href="{{ bevestigingsUrl }}" background-color="{{ organisatie.kleurPrimair }}" font-size="15px">Uitnodiging accepteren</mj-button>
        <mj-text font-size="13px" color="#777777">Deze link is persoonlijk en beperkt geldig.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>
